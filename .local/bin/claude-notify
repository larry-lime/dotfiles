#!/bin/bash

# Desktop + tmux notification for Claude Code hook events.
# Reads the hook JSON payload on stdin (cwd is used for the project name), fires
# a macOS notification, and flags the tmux window so it stands out in the status
# bar until you visit it. Wire it up as a Stop hook in ~/.claude/settings.json.
#
# Usage: claude-notify [message]
# Env:   CLAUDE_NOTIFY_SOUND  system sound name (default Glass; empty = silent)

# Modes (one window state at a time; shown as a dot in the tmux status bar
# and the tnav picker: yellow working, red needs you, green done):
#   (default)    Stop hook: drop working, flag @claude_done (unless on screen)
#   --working    Claude is busy (prompt submitted / tool ran): flag
#                @claude_working, drop attention + done. No notification.
#   --attention  Claude is blocked on you (permission prompt / question):
#                flag @claude_attention, cleared once Claude resumes
#   --clear      Session ended: drop every flag. No notification.
mode=done
case "$1" in
--attention) mode=attention; shift ;;
--working)
  [ -n "$TMUX_PANE" ] || exit 0
  tmux set-option -w -t "$TMUX_PANE" @claude_working "$(date +%s)" \; \
    set-option -uw -t "$TMUX_PANE" @claude_attention \; \
    set-option -uw -t "$TMUX_PANE" @claude_done 2>/dev/null
  # Remember the folders this window's Claude session works in (most recent
  # first, '|'-separated, max 8). snav (cmd+g) maps them to branches/stacks.
  cwd=$(jq -r '.cwd // empty' 2>/dev/null)
  if [ -n "$cwd" ]; then
    old=$(tmux show-options -wqv -t "$TMUX_PANE" @claude_cwds 2>/dev/null)
    case "|$old|" in
    "|$cwd|"*) ;; # already the most recent
    *)
      new=$({ printf '%s\n' "$cwd"; printf '%s' "$old" | tr '|' '\n' | grep -vxF -- "$cwd"; } |
        grep -v '^$' | head -8 | paste -sd '|' -)
      tmux set-option -w -t "$TMUX_PANE" @claude_cwds "$new" 2>/dev/null
      ;;
    esac
  fi
  exit 0
  ;;
--clear)
  [ -n "$TMUX_PANE" ] && tmux set-option -uw -t "$TMUX_PANE" @claude_working \; \
    set-option -uw -t "$TMUX_PANE" @claude_attention \; \
    set-option -uw -t "$TMUX_PANE" @claude_done 2>/dev/null
  exit 0
  ;;
esac

message=${1:-Finished}

payload=$(cat)
cwd=$(printf '%s' "$payload" | jq -r '.cwd // empty' 2>/dev/null)
project=${cwd:+$(basename "$cwd")}

# --- tmux: flag the window, unless you are already looking at it ------------
location=""
if [ -n "$TMUX_PANE" ] && command -v tmux >/dev/null 2>&1; then
  # Two calls rather than one delimited format, so session/window names
  # containing the delimiter can't corrupt the parse.
  focused=$(tmux display-message -p -t "$TMUX_PANE" '#{window_active}#{session_attached}' 2>/dev/null)
  location=$(tmux display-message -p -t "$TMUX_PANE" '#S:#I #W' 2>/dev/null)

  tmux set-option -uw -t "$TMUX_PANE" @claude_working 2>/dev/null
  if [ "$mode" = attention ]; then
    # Set even when on screen: it stays until Claude actually resumes.
    tmux set-option -w -t "$TMUX_PANE" @claude_attention "$(date +%s)" 2>/dev/null
  else
    tmux set-option -uw -t "$TMUX_PANE" @claude_attention 2>/dev/null
    if [ "$focused" != "11" ]; then
      # Timestamp doubles as the sort key for claude-jump.
      tmux set-option -w -t "$TMUX_PANE" @claude_done "$(date +%s)" 2>/dev/null
    fi
  fi
  tmux display-message -t "$TMUX_PANE" "Claude: ${project:-session} $message" 2>/dev/null
fi

# --- macOS desktop notification --------------------------------------------
title="Claude Code${project:+ - $project}"
subtitle=${location:-${cwd:-}}
sound=${CLAUDE_NOTIFY_SOUND-Glass}

# Values go in via argv so paths and branch names can't break out of the script.
if [ -n "$sound" ]; then
  osascript - "$title" "$subtitle" "$message" "$sound" <<'APPLESCRIPT'
on run argv
  display notification (item 3 of argv) with title (item 1 of argv) subtitle (item 2 of argv) sound name (item 4 of argv)
end run
APPLESCRIPT
else
  osascript - "$title" "$subtitle" "$message" <<'APPLESCRIPT'
on run argv
  display notification (item 3 of argv) with title (item 1 of argv) subtitle (item 2 of argv)
end run
APPLESCRIPT
fi
